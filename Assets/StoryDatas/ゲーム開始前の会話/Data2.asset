    StoryText: "\u306A\u306B\uFF1F\u5FD8\u308C\u305F\u3068\u306F\u8A00\u308F\u305B\u3093\u305E\u3002\u308F\u3057\u306E\u8170\u306E\u75DB\u3081\u6B62\u3081\u3092\u8CB7\u3063\u3066\u304A\u304F\u308C"
