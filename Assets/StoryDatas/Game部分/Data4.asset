  stories:
  - Background: {fileID: 6616850879249372216, guid: e5e4ca39b402a86448ca742b6b117db4, type: 3}
    CharacterImage: {fileID: 5854741782538742311, guid: 4024e5532a68c7e4493322227c318891, type: 3}
    StoryText: "\u304A\u75B2\u308C\u69D8\u3067\u3059\n"
    CharacterName: "\u8F9E\u4EFB\u30B9\u30DE\u30DB"
  - Background: {fileID: 6616850879249372216, guid: e5e4ca39b402a86448ca742b6b117db4, type: 3}
    CharacterImage: {fileID: 5854741782538742311, guid: 4024e5532a68c7e4493322227c318891, type: 3}
    StoryText: "\u3084\u3089\u308C\u305A\u306B\u30C9\u30E9\u30C3\u30B0\u30B9\u30C8\u30A2\u3078\u5230\u9054\u3067\u304D\u307E\u3057\u305F\u306D"
    CharacterName: "\u8F9E\u4EFB\u30B9\u30DE\u30DB"
  - Background: {fileID: 6616850879249372216, guid: e5e4ca39b402a86448ca742b6b117db4, type: 3}
    CharacterImage: {fileID: 5854741782538742311, guid: 4024e5532a68c7e4493322227c318891, type: 3}
    StoryText: "\u304A\u304A\u3001\u3088\u3046\u3084\u304F\u7740\u3044\u305F\u304B"
    CharacterName: "\uFF1F\uFF1F\uFF1F"
  - Background: {fileID: 6616850879249372216, guid: e5e4ca39b402a86448ca742b6b117db4, type: 3}
    CharacterImage: {fileID: -8147292683560006018, guid: fc9044e24de514343aa7485830d1c5ea, type: 3}
    StoryText: "\u3088\u304F\u305E\u3053\u3053\u307E\u3067\u305F\u3069\u308A\u7740\u3044\u305F"
    CharacterName: "\u304A\u3058\u3044\u3061\u3083\u3093"
  - Background: {fileID: 6616850879249372216, guid: e5e4ca39b402a86448ca742b6b117db4, type: 3}
    CharacterImage: {fileID: -8147292683560006018, guid: fc9044e24de514343aa7485830d1c5ea, type: 3}
    StoryText: "...\u3042\u3042\u3001\u75DB\u307F\u6B62\u3081\u304B\u3002\u78BA\u304B\u306B\u8CB7\u3063\u3066\u307B\u3057\u304B\u3063\u305F\u304C\u3001\u672C\u6765\u306E\u76EE\u7684\u306F\u305D\u3053\u3058\u3083\u306A\u3044"
    CharacterName: "\u304A\u3058\u3044\u3061\u3083\u3093"
  - Background: {fileID: 6616850879249372216, guid: e5e4ca39b402a86448ca742b6b117db4, type: 3}
    CharacterImage: {fileID: -8147292683560006018, guid: fc9044e24de514343aa7485830d1c5ea, type: 3}
    StoryText: "\u3053\u308C\u306F\u304A\u524D\u306E\u529B\u3092\u8A66\u3059\u8A66\u7DF4\u3060\u3063\u305F\u306E\u3058\u3083"
    CharacterName: "\u304A\u3058\u3044\u3061\u3083\u3093"
  - Background: {fileID: 6616850879249372216, guid: e5e4ca39b402a86448ca742b6b117db4, type: 3}
    CharacterImage: {fileID: -8147292683560006018, guid: fc9044e24de514343aa7485830d1c5ea, type: 3}
    StoryText: "\u3053\u3053\u307E\u3067\u6765\u308C\u305F\u3068\u3044\u3046\u3053\u3068\u306F\u3001\u304A\u524D\u306F\u4E00\u4EBA\u524D\u306E\u4EBA\u5916\u30DE\u30B9\u30BF\u30FC\u306B\u306A\u3063\u305F\u3068\u3044\u3046\u3053\u3068\u3058\u3083"
    CharacterName: "\u304A\u3058\u3044\u3061\u3083\u3093"
  - Background: {fileID: 6616850879249372216, guid: e5e4ca39b402a86448ca742b6b117db4, type: 3}
    CharacterImage: {fileID: -8147292683560006018, guid: fc9044e24de514343aa7485830d1c5ea, type: 3}
    StoryText: "\u304A\u3081\u3067\u3068\u3046\u3002\u3053\u308C\u304B\u3089\u3082\u4EBA\u5916\u306E\u9053\u3092\u6975\u3081\u3066\u3044\u304F\u3093\u3058\u3083\u305E"
    CharacterName: "\u304A\u3058\u3044\u3061\u3083\u3093"
  bgm: 0
